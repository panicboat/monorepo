{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":separateMajorReleases",
    "group:monorepos",
    "group:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "semanticCommitScope": "{{packageFileDir}}",
  "timezone": "Asia/Tokyo",
  "labels": [
    "🤖 renovate"
  ],
  "assigneesFromCodeOwners": false,
  "reviewersFromCodeOwners": true,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "platformAutomerge": true,
  "prConcurrentLimit": 15,
  "prHourlyLimit": 5,
  "branchPrefix": "renovate/",
  "rangeStrategy": "bump",
  "schedule": [
    "before 4am every weekday"
  ],
  "minimumReleaseAge": "1 day",
  "separateMinorPatch": false,
  "customManagers": [
    {
      "customType": "regex",
      "description": "go.mod's go directive as a docker-datasource dep, so it shares depName/packageFileDir with its Dockerfile's golang base image and the default grouping rule below bundles them into one PR",
      "fileMatch": [
        "(^|/)go\\.mod$"
      ],
      "matchStrings": [
        "^go (?<currentValue>\\d+\\.\\d+\\.\\d+)\\s*$"
      ],
      "depNameTemplate": "golang",
      "packageNameTemplate": "golang",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Default: separate PRs per package",
      "groupName": "{{packageFileDir}}/{{depName}}",
      "matchPackageNames": [
        "*"
      ]
    },
    {
      "description": "go.mod's go directive is owned by the custom manager above, not the stock gomod manager",
      "matchManagers": [
        "gomod"
      ],
      "matchDepTypes": [
        "golang"
      ],
      "matchDepNames": [
        "go"
      ],
      "enabled": false
    },
    {
      "description": "🚫 Production environments - disable automerge",
      "matchFileNames": [
        "**/production/**"
      ],
      "automerge": false,
      "prPriority": -1,
      "addLabels": [
        "⚠️ production"
      ]
    },
    {
      "description": "🚫 Major updates - disable automerge",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "addLabels": [
        "📈 major-update"
      ]
    },
    {
      "description": "✅ Minor/Patch updates - enable automerge",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true
    },
    {
      "description": "Track OpenTofu releases instead of Terraform for required_version",
      "matchDepTypes": [
        "required_version"
      ],
      "matchDepNames": [
        "hashicorp/terraform"
      ],
      "overridePackageName": "opentofu/opentofu"
    }
  ]
}
