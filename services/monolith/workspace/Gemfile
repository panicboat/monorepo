gem "aws-sdk-sns", "~> 1.118"

gem "jwt"
gem "bcrypt"
gem "pg"

gem "dry-types", "~> 1.9", ">= 1.9.1"
# hanami-validations was retired in Hanami 3; actions/contracts use dry-validation directly.
gem "dry-validation"
gem "dry-operation", ">= 1.1.0"
gem "puma"
# =============================================================================
# OpenTelemetry SDK + auto-instrumentation
# =============================================================================
gem "opentelemetry-sdk", "~> 1.13"
gem "opentelemetry-instrumentation-all", "~> 0.94"
gem "opentelemetry-exporter-otlp", "~> 0.34", ">= 0.34.1"
gem "rake"
gem "sqlite3"
gem "dotenv"

group :development do
  gem "hanami-webconsole", "~> 3.0"
  # Pinned to match the version used to commit checked-in stubs.
  # Different grpc-tools versions emit different `R<jsonName>` annotations
  # in the descriptor blob, causing spurious churn on `bin/codegen`.
  # 1.81.1 is the minimum that supports Ruby 4.0 (earlier versions cap at
  # `< 3.5.dev` on Linux platform gemspecs).
  gem "grpc-tools", "1.83.0"
end

group :development, :test do
  gem "faker", "~> 3.8"
end

group :cli, :development do
  gem "hanami-reloader", "~> 3.0"
end

group :cli, :development, :test do
  gem "hanami-rspec", "~> 3.0"
end

group :test do
  # Database
  gem "database_cleaner-sequel"

  # Web integration
  gem "capybara"
  gem "rack-test"
end
