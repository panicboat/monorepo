#!/bin/sh
set -e

echo "Running migrations..."
if [ -f "Gemfile" ]; then
  bundle exec hanami db create
  # Use --no-dump because the image's pg_dump is older than the RDS server.
  bundle exec hanami db migrate --no-dump
else
  echo "Gemfile not found, skipping migrations."
fi

echo "Starting gRPC server..."
exec ./bin/grpc
