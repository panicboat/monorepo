#!/usr/bin/env ruby

# Keep development gems out of the gRPC process because the reloader causes Zeitwerk errors.
ENV["BUNDLE_WITHOUT"] = "development:cli:test"
ENV["HANAMI_ENV"] = "production"
ENV["SECRET_KEY_BASE"] ||= "development_secret_key_base_for_local_production_mode"

STDOUT.sync = true
STDERR.sync = true

require "bundler/setup"
require "hanami/setup"

Hanami.app.boot

# Suppress reload calls because the gRPC process must not run the development reloader.
require "zeitwerk"
class Zeitwerk::Loader
  def reload
    puts "DEBUG: Zeitwerk::Loader#reload called (suppressed for gRPC)"
    true
  end
end

require "gruf"
require_relative "../lib/current"
require_relative "../lib/telemetry"
require_relative "../lib/types"
require_relative "../lib/interceptors/access_log_interceptor"
require_relative "../lib/interceptors/authentication_interceptor"

$LOAD_PATH.unshift(File.expand_path("../stubs", __dir__))
$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))
require "identity/v1/service_services_pb"
require "profile/v1/service_services_pb"
require "media/v1/media_service_services_pb"
require "social/v1/follow_service_services_pb"
require "social/v1/block_service_services_pb"
require "post/v1/post_service_services_pb"
require "post/v1/like_service_services_pb"
require "post/v1/comment_service_services_pb"
require "feed/v1/feed_service_services_pb"
require "notifications/v1/notification_service_services_pb"
require "bookmarks/v1/bookmark_service_services_pb"
require "discovery/v1/discovery_service_services_pb"
require "messaging/v1/messaging_service_services_pb"
require "footprints/v1/footprints_service_services_pb"
require "schedule/v1/schedule_service_services_pb"
require "karte/v1/service_services_pb"
require "review/v1/service_services_pb"
require "billing/v1/service_services_pb"

# Initialize OpenTelemetry before Gruf so its interceptor classes are available during chain setup.
otel_enabled = Telemetry.configure

Gruf.configure do |c|
  c.logger = Hanami.logger

  c.server_binding_url = ENV.fetch("GRPC_BIND_ADDRESS", "0.0.0.0:9001")
  # Keep authentication first so each request remains in one trace.
  if otel_enabled
    c.interceptors.use(OpenTelemetry::Instrumentation::Gruf::Interceptors::Server)
  end
  c.interceptors.use(Interceptors::AccessLogInterceptor)
  c.interceptors.use(Interceptors::AuthenticationInterceptor)

  # Raise the HTTP/2 stream cap because long-lived messaging streams share the connection with unary RPCs.
  c.server_options = {
    "grpc.max_concurrent_streams" => 1024,
  }
end

require_relative "../slices/identity/grpc/handler"
require_relative "../slices/profile/grpc/handler"
require_relative "../slices/profile/grpc/profile_handler"
require_relative "../slices/media/grpc/handler"
require_relative "../slices/social/grpc/handler"
require_relative "../slices/social/grpc/follow_handler"
require_relative "../slices/social/grpc/block_handler"
require_relative "../slices/post/grpc/handler"
require_relative "../slices/post/grpc/post_handler"
require_relative "../slices/post/grpc/like_handler"
require_relative "../slices/post/grpc/comment_handler"
require_relative "../slices/feed/grpc/handler"
require_relative "../slices/notifications/grpc/handler"
require_relative "../slices/notifications/grpc/notification_handler"
require_relative "../slices/bookmarks/grpc/handler"
require_relative "../slices/bookmarks/grpc/bookmark_handler"
require_relative "../slices/discovery/grpc/handler"
require_relative "../slices/discovery/grpc/discovery_handler"
require_relative "../slices/messaging/grpc/handler"
require_relative "../slices/messaging/grpc/messaging_handler"
require_relative "../slices/footprints/grpc/handler"
require_relative "../slices/footprints/grpc/footprints_handler"
require_relative "../slices/schedule/grpc/handler"
require_relative "../slices/schedule/grpc/schedule_handler"
require_relative "../slices/karte/grpc/handler"
require_relative "../slices/karte/grpc/karte_handler"
require_relative "../slices/review/grpc/handler"
require_relative "../slices/review/grpc/review_handler"
require_relative "../slices/billing/grpc/handler"
require_relative "../slices/billing/grpc/billing_handler"

Hanami.logger.info("Starting gRPC Stub Server on #{Gruf.server_binding_url}")
Hanami.logger.info("Services: #{Gruf.services}")

Gruf::Cli::Executor.new.run
