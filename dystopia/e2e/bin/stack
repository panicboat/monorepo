#!/usr/bin/env bash
set -euo pipefail

E2E_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
MONOLITH_DIR="$(cd "$E2E_DIR/../monolith" && pwd)"
FRONTEND_DIR="$(cd "$E2E_DIR/../frontend" && pwd)"
STACK_DIR="$E2E_DIR/.e2e/stack"

# Hanami appends _test to the database name of this URL under HANAMI_ENV=test.
DB_URL="postgres://postgres:password@localhost:5432/monolith_e2e"
MONOLITH_DB_URL="${DB_URL}_test"
MONOLITH_HOST="127.0.0.1"
MONOLITH_PORT="9055"
MONOLITH_ADDRESS="${MONOLITH_HOST}:${MONOLITH_PORT}"
FRONTEND_PORT="3055"
READY_URL="http://127.0.0.1:${FRONTEND_PORT}/api/identity/sign-in"
READY_BODY='{"phoneNumber":"+819000000101","password":"password"}'
READY_TIMEOUT_SECONDS=180
READY_INTERVAL_SECONDS=2
STOP_TIMEOUT_SECONDS=30

# Pinned rather than latest so that a new emulator release cannot fail a run whose code did not change.
AWS_EMULATOR_VERSION="1.0.338"
EMULATOR_PORT="9297"
RELAY_PORT="9298"
MEDIA_BUCKET="dystopia-media-e2e"
MEDIA_REGION="us-east-1"
EMULATOR_HOME="$STACK_DIR/emulator-home"
EMULATOR_CONTAINER="dystopia-e2e-aws-emulator"
EMULATOR_IMAGE="dystopia-e2e-aws-emulator:${AWS_EMULATOR_VERSION}"
EMULATOR_PACKAGE_URL="https://downloads.aws.com/aws-emulator/packages/aws-emulator/LTS"
EMULATOR_DIR="$EMULATOR_HOME/.aws/emulator/$EMULATOR_PORT"
EMULATOR_CA="$EMULATOR_DIR/ca.pem"
EMULATOR_CREDENTIALS="$EMULATOR_DIR/emulator_credentials"
EMULATOR_TIMEOUT_SECONDS=60
RELAY_TIMEOUT_SECONDS=10
EMULATOR_MODE="docker"
if [[ "$(uname -s)" == "Linux" ]]; then
  EMULATOR_MODE="native"
fi

usage() {
  echo "usage: bin/stack up|down|install-emulator" >&2
  exit 2
}

BUNDLE_EXEC=(bundle exec)
if command -v rbenv >/dev/null 2>&1; then
  BUNDLE_EXEC=(rbenv exec bundle exec)
fi

hanami_db() {
  (cd "$MONOLITH_DIR" && HANAMI_ENV=test DATABASE_URL="$DB_URL" "${BUNDLE_EXEC[@]}" hanami db "$@")
}

port_in_use() {
  (exec 3<>"/dev/tcp/$1/$2") 2>/dev/null
}

descendants() {
  local child
  for child in $(pgrep -P "$1" || true); do
    descendants "$child"
    echo "$child"
  done
}

any_alive() {
  local pid
  for pid in "$@"; do
    kill -0 "$pid" 2>/dev/null && return 0
  done
  return 1
}

# gruf rewrites its process title, so processes are found through the PID files instead of by name.
stop_process() {
  local pid_file="$STACK_DIR/$1.pid"
  [[ -f "$pid_file" ]] || return 0
  local pid
  pid="$(<"$pid_file")"
  if kill -0 "$pid" 2>/dev/null; then
    local pids
    read -r -a pids <<<"$(descendants "$pid" | tr '\n' ' ') $pid"
    # SILENT: a process in the tree may exit on its own before it is signalled.
    kill -TERM "${pids[@]}" 2>/dev/null || true
    local waited=0
    while any_alive "${pids[@]}" && ((waited < STOP_TIMEOUT_SECONDS)); do
      sleep 1
      waited=$((waited + 1))
    done
    # SILENT: the processes that exited after TERM are no longer there to kill.
    kill -KILL "${pids[@]}" 2>/dev/null || true
  fi
  rm -f "$pid_file"
}

stop_emulator() {
  if [[ "$EMULATOR_MODE" == "native" ]]; then
    stop_process aws-emulator
  else
    # SILENT: the container is absent when it never started, and docker itself may be stopped.
    docker rm -f "$EMULATOR_CONTAINER" >/dev/null 2>&1 || true
  fi
  # docker rm -f kills the emulator before it removes its keys, and the next run would read the stale ones.
  rm -rf "$EMULATOR_HOME"
}

stop_processes() {
  stop_process frontend
  stop_process monolith
  stop_process s3-relay
  stop_emulator
}

print_logs() {
  local name
  for name in aws-emulator s3-relay monolith frontend; do
    if [[ -f "$STACK_DIR/$name.log" ]]; then
      echo "--- tail of $STACK_DIR/$name.log" >&2
      tail -n 50 "$STACK_DIR/$name.log" >&2
    fi
  done
}

on_up_failure() {
  echo "bin/stack up failed; stopping the stack" >&2
  print_logs
  down
}

prepare_database() {
  hanami_db drop
  hanami_db create
  hanami_db migrate --no-dump
  hanami_db seed
}

# Real AWS credentials must not reach the processes that talk to the emulator, so they are dropped here.
run_with_s3_env() {
  env -u AWS_PROFILE -u AWS_DEFAULT_PROFILE -u AWS_ACCESS_KEY_ID -u AWS_SECRET_ACCESS_KEY -u AWS_SESSION_TOKEN \
    AWS_ENDPOINT_URL="http://127.0.0.1:${RELAY_PORT}" \
    AWS_SHARED_CREDENTIALS_FILE="$EMULATOR_CREDENTIALS" \
    AWS_CONFIG_FILE=/dev/null \
    AWS_REGION="$MEDIA_REGION" \
    MEDIA_BUCKET_NAME="$MEDIA_BUCKET" \
    MEDIA_BUCKET_REGION="$MEDIA_REGION" \
    "$@"
}

emulator_alive() {
  if [[ "$EMULATOR_MODE" == "native" ]]; then
    kill -0 "$(<"$STACK_DIR/aws-emulator.pid")" 2>/dev/null
  else
    # SILENT: a container that does not exist is not running.
    [[ "$(docker inspect -f '{{.State.Running}}' "$EMULATOR_CONTAINER" 2>/dev/null || true)" == "true" ]]
  fi
}

emulator_healthy() {
  local status
  # SILENT: a refused connection or a missing ca.pem means the emulator is not up yet, and the caller asks again.
  status="$(curl -s --max-time 5 --cacert "$EMULATOR_CA" -o /dev/null -w '%{http_code}' "https://127.0.0.1:${EMULATOR_PORT}/__admin/health" || true)"
  [[ "$status" == "200" ]]
}

relay_alive() {
  kill -0 "$(<"$STACK_DIR/s3-relay.pid")" 2>/dev/null
}

relay_listening() {
  port_in_use 127.0.0.1 "$RELAY_PORT"
}

wait_for() {
  local name="$1" timeout="$2" is_ready="$3" is_alive="$4" waited=0
  while ((waited < timeout)); do
    "$is_ready" && return 0
    if ! "$is_alive"; then
      echo "$name exited before it became ready" >&2
      return 1
    fi
    sleep 1
    waited=$((waited + 1))
  done
  echo "$name was not ready within ${timeout}s" >&2
  return 1
}

check_emulator_prerequisites() {
  if [[ "$EMULATOR_MODE" == "native" ]]; then
    if ! command -v aws-emulator >/dev/null 2>&1; then
      echo "aws-emulator is not on PATH; run bin/stack install-emulator first" >&2
      exit 1
    fi
  elif ! docker info >/dev/null 2>&1; then
    echo "docker is not running; outside Linux bin/stack runs aws-emulator in a container, so start Docker and retry" >&2
    exit 1
  fi
}

install_emulator() {
  if [[ "$EMULATOR_MODE" != "native" ]]; then
    echo "install-emulator is for Linux; elsewhere bin/stack up builds the image from emulator/Dockerfile" >&2
    exit 1
  fi
  local arch file
  arch="$(dpkg --print-architecture)"
  file="aws-emulator_${AWS_EMULATOR_VERSION}-1_${arch}.deb"
  (
    tmp="$(mktemp -d)"
    trap 'rm -rf "$tmp"' EXIT
    cd "$tmp"
    curl -fsSL -o "$file" "${EMULATOR_PACKAGE_URL}/${file}"
    sudo apt-get install -y "./$file"
  )
}

start_emulator() {
  mkdir -p "$EMULATOR_HOME"
  if [[ "$EMULATOR_MODE" == "native" ]]; then
    (
      export HOME="$EMULATOR_HOME"
      exec aws-emulator -b 127.0.0.1 --telemetry off
    ) >"$STACK_DIR/aws-emulator.log" 2>&1 &
    echo $! >"$STACK_DIR/aws-emulator.pid"
  else
    docker build -q --build-arg "AWS_EMULATOR_VERSION=${AWS_EMULATOR_VERSION}" -t "$EMULATOR_IMAGE" "$E2E_DIR/emulator" >/dev/null
    docker run -d --name "$EMULATOR_CONTAINER" -p "127.0.0.1:${EMULATOR_PORT}:${EMULATOR_PORT}" -v "$EMULATOR_HOME:/home/emulator" "$EMULATOR_IMAGE" >/dev/null
    # The follower ends when the container is removed, so it needs no PID file.
    docker logs -f "$EMULATOR_CONTAINER" >"$STACK_DIR/aws-emulator.log" 2>&1 &
  fi
}

start_s3_relay() {
  (
    export RELAY_PORT EMULATOR_PORT EMULATOR_CA ALLOWED_ORIGIN="http://localhost:${FRONTEND_PORT}"
    exec env -u NODE_OPTIONS node "$E2E_DIR/bin/s3-relay.mjs"
  ) >"$STACK_DIR/s3-relay.log" 2>&1 &
  echo $! >"$STACK_DIR/s3-relay.pid"
}

create_media_bucket() {
  (cd "$MONOLITH_DIR" && run_with_s3_env "${BUNDLE_EXEC[@]}" ruby -e 'require "aws-sdk-s3"; Aws::S3::Client.new.create_bucket(bucket: ENV.fetch("MEDIA_BUCKET_NAME"))')
}

start_monolith() {
  (
    cd "$MONOLITH_DIR"
    set -a
    # bin/grpc forces HANAMI_ENV=production, so the test settings must come from the environment.
    # shellcheck source=/dev/null
    . ./.env
    # shellcheck source=/dev/null
    . ./.env.test
    set +a
    export DATABASE_URL="$MONOLITH_DB_URL" GRPC_BIND_ADDRESS="$MONOLITH_ADDRESS"
    run_with_s3_env "${BUNDLE_EXEC[@]}" ruby bin/grpc
  ) >"$STACK_DIR/monolith.log" 2>&1 &
  echo $! >"$STACK_DIR/monolith.pid"
}

start_frontend() {
  (cd "$FRONTEND_DIR" && env -u NODE_OPTIONS pnpm install --frozen-lockfile && env -u NODE_OPTIONS pnpm build)
  (
    cd "$FRONTEND_DIR"
    export COGNITO_ADAPTER=fake MONOLITH_URL="http://${MONOLITH_ADDRESS}" INSECURE_COOKIES=true
    exec env -u NODE_OPTIONS pnpm start --port "$FRONTEND_PORT"
  ) >"$STACK_DIR/frontend.log" 2>&1 &
  echo $! >"$STACK_DIR/frontend.pid"
}

wait_until_ready() {
  local waited=0 status name
  while ((waited < READY_TIMEOUT_SECONDS)); do
    # SILENT: a refused or timed-out request means the stack is not ready yet, and the loop asks again.
    status="$(curl -s --max-time 10 -o /dev/null -w '%{http_code}' -X POST -H 'Content-Type: application/json' -d "$READY_BODY" "$READY_URL" || true)"
    [[ "$status" == "200" ]] && return 0
    for name in monolith frontend s3-relay; do
      if ! kill -0 "$(<"$STACK_DIR/$name.pid")" 2>/dev/null; then
        echo "$name exited before the stack became ready" >&2
        return 1
      fi
    done
    if ! emulator_alive; then
      echo "aws-emulator exited before the stack became ready" >&2
      return 1
    fi
    sleep "$READY_INTERVAL_SECONDS"
    waited=$((waited + READY_INTERVAL_SECONDS))
  done
  echo "sign-in did not return 200 within ${READY_TIMEOUT_SECONDS}s (last status: ${status})" >&2
  return 1
}

up() {
  mkdir -p "$STACK_DIR"
  stop_processes
  local port
  for port in "$MONOLITH_PORT" "$FRONTEND_PORT" "$EMULATOR_PORT" "$RELAY_PORT"; do
    if port_in_use 127.0.0.1 "$port"; then
      echo "port ${port} is held by a process this script did not start" >&2
      exit 1
    fi
  done
  check_emulator_prerequisites
  trap on_up_failure EXIT
  start_emulator
  wait_for aws-emulator "$EMULATOR_TIMEOUT_SECONDS" emulator_healthy emulator_alive
  start_s3_relay
  wait_for s3-relay "$RELAY_TIMEOUT_SECONDS" relay_listening relay_alive
  create_media_bucket
  prepare_database
  start_monolith
  start_frontend
  wait_until_ready
  trap - EXIT
  echo "stack is ready at http://localhost:${FRONTEND_PORT}"
}

down() {
  stop_processes
  hanami_db drop
}

case "${1:-}" in
  up) up ;;
  down) down ;;
  install-emulator) install_emulator ;;
  *) usage ;;
esac
