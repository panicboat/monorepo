{
  "name": "meeting-translation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm build:web && pnpm build:server",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "dev": "concurrently -k -n web,server \"pnpm run dev:web\" \"pnpm run dev:server\"",
    "dev:web": "vite --host 0.0.0.0",
    "dev:server": "PORT=3001 tsx watch src/server/main.ts",
    "start": "node dist/server/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "3.1128.0",
    "@aws-sdk/client-transcribe-streaming": "3.1128.0",
    "@fastify/static": "10.1.3",
    "@fastify/websocket": "11.3.0",
    "fastify": "5.12.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
